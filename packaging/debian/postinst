#!/bin/sh
set -e
if [ "$1" = "configure" ]; then
    # Autostart für alle Benutzer beim Anmelden
    systemctl --global enable lernsperre.service >/dev/null 2>&1 || true
    echo ""
    echo "LernSperre ist installiert."
    echo "Neu installiert: einmal ab- und wieder anmelden. Danach laufen Dienst und GNOME-Erweiterung automatisch."
    echo "Update: siehe Changelog, meist reicht neu anmelden oder: systemctl --user restart lernsperre"
    echo "https://github.com/janiktest/lernsperre/blob/main/CHANGELOG.md"
    echo ""
fi
exit 0
