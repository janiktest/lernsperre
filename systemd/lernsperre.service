[Unit]
Description=LernSperre – Ablenkung sperren, in Anki lernen
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
Environment=PYTHONPATH=%h/.local/share/lernsperre/app
ExecStart=/usr/bin/python3 -m lernsperre run
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
